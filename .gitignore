backups/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Node / web / desktop
node_modules/
apps/web/dist/
apps/web/coverage/
apps/desktop/dist/
apps/desktop/out/
apps/desktop/release/
apps/desktop/coverage/
