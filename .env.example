# ---------------------------------------------------------------------------
# JARVIS AI configuration. Copy to .env and replace every CHANGE_ME value.
# Never commit .env. Never put real API keys in this file.
# ---------------------------------------------------------------------------

# development | test | production
JARVIS_ENV=development
LOG_LEVEL=INFO

# PostgreSQL (SQLAlchemy async URL). The default matches docker-compose.yml.
DATABASE_URL=postgresql+asyncpg://jarvis:CHANGE_ME@localhost:5432/jarvis

# Fernet key for encrypting stored credentials. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required when JARVIS_ENV=production. In development a key is created in DATA_DIR/secret.key.
ENCRYPTION_KEY=

DATA_DIR=./data

# Web origin and cookies. In production use https and COOKIE_SECURE=true.
PUBLIC_BASE_URL=http://localhost:5173
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
COOKIE_SECURE=false
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT_PER_MINUTE=10
API_RATE_LIMIT_PER_MINUTE=600

# Devices and tasks
DEVICE_HEARTBEAT_TIMEOUT_SECONDS=45
DEVICE_PAIRING_CODE_TTL_SECONDS=600
DEVICE_COMMAND_TTL_SECONDS=60
DEVICE_COMMAND_TIMEOUT_SECONDS=120
DEVICE_MAX_PAIRING_ATTEMPTS=5
TASK_APPROVAL_TTL_SECONDS=600
TASK_QUEUE_TTL_SECONDS=1800

# AI providers. Keys are entered in the web app (AI Models page) and stored encrypted.
# Base URLs can be overridden here, for example to point at a regional or test endpoint.
PROVIDER_DEFAULT_TIMEOUT_SECONDS=30
PROVIDER_DEFAULT_MAX_RETRIES=2
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
HUGGINGFACE_BASE_URL=https://router.huggingface.co
HUGGINGFACE_WHOAMI_URL=https://huggingface.co/api/whoami-v2
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://localhost

# Metrics for operators at GET /api/v1/metrics (Bearer token). Empty means the endpoint answers 404.
METRICS_TOKEN=

# Background workers (scheduler and heartbeat monitor)
RUN_BACKGROUND_WORKERS=true
SCHEDULER_POLL_SECONDS=5
SSE_HEARTBEAT_SECONDS=15

# Optional integration credentials (reserved; no integration is implemented yet)
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
